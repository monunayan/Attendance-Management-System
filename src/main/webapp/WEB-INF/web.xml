<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee 
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>College Attendance Management System</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.cams.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentRegisterServlet</servlet-name>
        <servlet-class>com.cams.servlet.StudentRegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentRegisterServlet</servlet-name>
        <url-pattern>/StudentRegisterServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FacultyRegisterServlet</servlet-name>
        <servlet-class>com.cams.servlet.FacultyRegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FacultyRegisterServlet</servlet-name>
        <url-pattern>/FacultyRegisterServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AttendanceServlet</servlet-name>
        <servlet-class>com.cams.servlet.AttendanceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AttendanceServlet</servlet-name>
        <url-pattern>/AttendanceServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UpdateSemesterServlet</servlet-name>
        <servlet-class>com.cams.servlet.UpdateSemesterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdateSemesterServlet</servlet-name>
        <url-pattern>/UpdateSemesterServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddSubjectServlet</servlet-name>
        <servlet-class>com.cams.servlet.AddSubjectServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddSubjectServlet</servlet-name>
        <url-pattern>/AddSubjectServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeleteSubjectServlet</servlet-name>
        <servlet-class>com.cams.servlet.DeleteSubjectServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteSubjectServlet</servlet-name>
        <url-pattern>/DeleteSubjectServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <servlet-class>com.cams.servlet.ForgotPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <url-pattern>/ForgotPasswordServlet</url-pattern>
    </servlet-mapping>

</web-app>

